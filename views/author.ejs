<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"
      rel="stylesheet"
    />

    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.1.1/js/bootstrap.min.js"></script>
    <link rel="stylesheet" href="/main.css" />
    <title>Potfolio</title>
  </head>
  <body>
    <div class="frame">
      <div class="main_frame">
        <!-- Left frame -->
        <div class="left_frame">
          <div class="left_1">
            <div class="left_1-1">
                <img src="images/profile.png"
                width="156px"
                height="142px" 
                 alt="profile">
            </div>
            <div class="left_1-2">
                <%=user.name%>
            </div>
            <div class="left_1-3">
                <%=user.profession%>
            </div>
            <div class="left-icons">
                <a class="link_href" href="">
                    <div class="icon">
                        <img src="icon/Facebook.svg" class="icon-1" alt="">
                    </div>
                </a>
                <a class="link_href" href="">
                    <div class="icon">
                        <img src="icon/Instagram.svg" class="icon-1" alt="">
                    </div>
                </a>
                <a class="link_href" href="">
                    <div class="icon">
                        <img src="icon/Twitter.svg" class="icon-1" alt="">
                    </div>
                </a>
                <a class="link_href" href="">
                    <div class="icon">
                        <img src="icon/Linkedin.svg" class="icon-1" alt="">
                    </div>
                </a>
                <a class="link_href" href="">
                    <div class="icon">
                        <img src="icon/Youtube.svg" class="icon-1" alt="">
                    </div>
                </a>
                <a class="link_href" href="">
                    <div class="icon">
                        <img src="icon/Dribbble.svg" class="icon-1" alt="">
                    </div>
                </a>
            </div>
          </div>
          <div class="marginer"></div>
          <div class="left_2">
            <div class="left_2_info">
                <span class="left_2_dec">Age:</span>
                <span><%=user.age%></span>
            </div>
            <div class="left_2_info">
                <span class="left_2_dec">Residence:</span>
                <span><%=user.residence%></span>
            </div>
            <div class="left_2_info">
                <span class="left_2_dec">Freelance:</span>
                <span style="color: green">Available</span>
            </div>
            <div class="left_2_info">
                <span class="left_2_dec">Adress:</span>
                <span><%=user.address%></span>
            </div>
          </div>
          <div class="marginer"></div>
          <div class="left_3">
            <strong>Languages</strong>
            <div class="left_3_info">
                 <span><%=user.languages[0]%></span>
                 <span>100%</span>  
            </div>
            <div class="progress">
                    <div class="prog_bar"></div>
                 </div>
                 <div class="left_3_info">
                 <span><%=user.languages[1]%></span>
                 <span>50%</span>  
            </div>
            <div class="progress">
                    <div class="prog_bar_k"></div>
                 </div>
                 <div class="left_3_info">
                 <span><%=user.languages[2]%></span>
                 <span>100%</span>  
            </div>
            <div class="progress">
                    <div class="prog_bar"></div>
                 </div>
          </div>
          <div class="marginer"></div>
          <div class="left_4">
            <strong>Skills</strong>
            <div class="left_4_info" >
                <span><%=user.skills[0]%></span>
                <span>90%</span>
            </div>
            <div class="progress">
                    <div class="prog_bar_html"></div>
                 </div>
                 <div class="left_4_info" >
                <span><%=user.skills[1]%></span>
                <span>90%</span>
            </div>
            <div class="progress">
                    <div class="prog_bar_html"></div>
                 </div>
                 <div class="left_4_info" >
                <span><%=user.skills[2]%></span>
                <span>80%</span>
            </div>
            <div class="progress">
                    <div class="prog_bar_js"></div>
                 </div>
                 <div class="left_4_info" >
                <span><%=user.skills[3]%></span>
                <span>75%</span>
            </div>
            <div class="progress">
                    <div class="prog_bar_nodeJS"></div>
                 </div>
                 <div class="left_4_info" >
                <span><%=user.skills[4]%></span>
                <span>85%</span>
            </div>
            <div class="progress">
                    <div class="prog_bar_python"></div>
                 </div>
          </div>
          <div class="marginer"></div>
          <div class="left_5">
            <strong>Extra skills</strong>
            <div  class="left_5_info">
                <img src="icon/Icons.svg" alt="">
                <span><%=user.extra_skills[0]%>, <%=user.extra_skills[1]%></span>
            </div>
            <div  class="left_5_info">
                <img src="icon/Icons.svg" alt="">
                <span><%=user.extra_skills[2]%></span>
            </div>
            <div  class="left_5_info">
                <img src="icon/Icons.svg" alt="">
                <span><%=user.extra_skills[3]%>, <%=user.extra_skills[4]%></span>
            </div>
            <div  class="left_5_info">
                <img src="icon/Icons.svg" alt="">
                <span><%=user.extra_skills[5]%></span>
            </div>
          </div>
          
          <div class="marginer"></div>
        <!-- End of left frame -->
        <!-- midd frame -->
      </div>
      <div class="midd_frame">
        <div class="midd_frame_top">
            <div class="midd_frame_top_info">
                <b><%=user.work_place%></b>
                <span><%=user.about_me%></span>
                <a href="">HIRE ME →</a>
            </div>
            <div class="midd_frame_top_img">
                <img src="icon/Your Image.svg" alt="">
            </div>
            <div class="icony orange_ell">
                <img src="btn_icon/Ellipse15.svg" alt="">
            </div>
            <div class="icony orange_ell1">
                <img src="btn_icon/Ellipse15.svg" alt="">
            </div>
            <div class="icony green_ell">
                <img src="btn_icon/Ellipse16.svg" alt="">
            </div>
            <div class="icony green_ell1">
                <img src="btn_icon/Ellipse16.svg" alt="">
            </div>
            <div class="icony orange_rec">
                <img src="btn_icon/Rectangle51.svg" alt="">
            </div>
            <div class="icony blue_rec">
                <img src="btn_icon/Rectangle52.svg" alt="">
            </div>
            <div class="icony triangle">
                <img src="btn_icon/Triangle.svg" alt="">
            </div>
        </div>
        <div class="mid_frame_midd">
            <strong>My Services</strong>
            <span><%=user.service_desc%></span>

        </div>
        <div class="mid_frame_bott">
            <div class="mid_frame_bott_info">
                <img src="box_images/coding.svg" alt="">
                <b>Web Development</b>
                <span>Blog, E-Commerce</span>
            </div>
            <div class="mid_frame_bott_info">
                <img src="box_images/illustration.svg" alt="">
                <b>UI/UX Design</b>
                <span>Mobile App, Website Design</span>
            </div>
            <div class="mid_frame_bott_info">
                <img src="box_images/Icons_Microphone.svg" alt="">
                <b>Sound Design</b>
                <span>Voice Over, Beat Making</span>
            </div>
            <div class="mid_frame_bott_info">
                <img src="box_images/game-development.svg" alt="">
                <b>Game Design</b>
                <span>Character Design, Props & Objects</span>
            </div>
            <div class="mid_frame_bott_info">
                <img src="box_images/Photographer.svg" alt="">
                <b>Photography</b>
                <span>Portrait, Product Photography</span>
            </div>
            <div class="mid_frame_bott_info">
                <b>Advertising</b>
                <span class="last_str">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vitae nulla diam in ac dictum a urna viverra morbi.</span>
                <a href="">
                    <span>ORDER NOW ></span>
                </a>
            </div>
        </div>
      </div>
      <!-- End of midd frame -->

      <!-- Right Frame -->
      <div class="right_frame">
        <a href="" class="contrast">
            <img src="menu_icon/contrast_icon.svg" alt="">
        </a>
       <div class="panels">
         <a href="">
            <img src="menu_icon/Home.svg" alt="">
        </a>
        <a href="">
            <img src="menu_icon/Service.svg" alt="">
        </a>
        <a href="">
            <img src="menu_icon/Portfolio.svg" alt="">
        </a>
        <a href="">
            <img src="menu_icon/CV.svg" alt="">
        </a>
        <a href="">
            <img src="menu_icon/Blog.svg" alt="">
        </a>
        <a href="">
            <img src="menu_icon/Contact.svg" alt="">
        </a>
       </div>
      </div>
    </div>
  </body>
</html>
